# Copy to .env.local and fill in before deploying to production.
# See src/lib/site.ts for how this is used and what it falls back to
# in dev/preview when unset.

# The real production domain (no trailing slash). Drives canonical URLs,
# sitemap.xml, robots.txt, Open Graph URLs, and JSON-LD — all currently
# fall back to a placeholder until this is set (docs/open-questions.md #3).
NEXT_PUBLIC_SITE_URL=https://arvexa.com
